# ============================================================
# Variables de entorno del Frontend (Vite)
# Copia este archivo a `.env.local` y completá los valores reales.
# En Vite, las variables expuestas al cliente deben usar el prefijo VITE_.
# ============================================================

# URL base de la API del backend.
VITE_API_URL=http://localhost:8000/api/v1

# --- Autenticación (Clerk) ---
# Clave pública de publicación de la instancia de Clerk.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
