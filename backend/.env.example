# ============================================================
# Variables de entorno del Backend
# Copia este archivo a `.env` y completá los valores reales.
# NUNCA commits `.env` con secretos reales.
# ============================================================

# --- Base de datos (PostgreSQL) ---
# Usá estos mismos valores en docker-compose.yml para el servicio de PostgreSQL.
POSTGRES_USER=finances
POSTGRES_PASSWORD=finances_dev_password
POSTGRES_DB=finances
DATABASE_URL=postgresql+psycopg://finances:finances_dev_password@localhost:5432/finances

# --- Backend ---
# Ambiente: development | production
ENVIRONMENT=development
# Host y puerto del servidor Uvicorn
HOST=0.0.0.0
PORT=8000
# Orígenes permitidos para CORS (separados por coma)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Autenticación (Clerk) ---
# Clave pública del dominio de Clerk. Se usa para verificar los JWT de Clerk.
CLERK_JWKS_URL=https://tu-dominio.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://tu-dominio.clerk.accounts.dev
CLERK_AUDIENCE=
